```gitignore
# Dependencies
vendor/

# Logs and temp files
*.log
*.tmp

# Environment
.env
.env.local
*.env.*

# Editors
.vscode/
.idea/

# OS generated files
.DS_Store
Thumbs.db

# Build artifacts
dist/
build/
*.o
*.obj
*.exe
*.dll
*.so
*.a
*.out

# Python specific
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
.eggs/
.coverage
htmlcov/
.coverage.*
.nosetests.xml
coverage.xml
*.cover
*.log

# PHP specific
*.php~
*.php.bak
*.swp
*.swo

# Uploads (except the .gitkeep file)
uploads/*
!uploads/.gitkeep
```